# Server Configuration
PORT=3000

# Environment
NODE_ENV=development

# Authentication - CHANGE THESE VALUES FOR PRODUCTION
ADMIN_PASSWORD=your_secure_password_here
SESSION_SECRET=generate_random_secret_key_here_min_32_chars

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Image Processing
IMAGE_QUALITY=82
MAX_RESOLUTION_WIDTH=2560
MAX_RESOLUTION_HEIGHT=2560

# Slideshow Configuration
DEFAULT_SLIDESHOW_INTERVAL=15000

# Random Image Configuration
MAX_RECENT_IMAGES=10
IMAGE_CACHE_EXPIRY=60000

# Default Folders
DEFAULT_FOLDERS=family,vacation,holidays,misc

# Google Photos Configuration
# Set to 'true' to enable Google Photos integration, 'false' to disable
ENABLE_GOOGLE_PHOTOS=false
GOOGLE_CLIENT_ID=client_id
GOOGLE_CLIENT_SECRET=client_secret
GOOGLE_REDIRECT_URI=redirect_uri
# Encryption at rest (optional, off when unset)
# Photos, snaps and data files (notes, devices, photo dates/places) are stored encrypted.
# Generate a key with: openssl rand -base64 32
# Back the key up somewhere safe: without it, encrypted photos can't be read.
# Thumbnails in CACHE_DIR are not encrypted (they can be deleted at any time).
# PHOTO_ENCRYPTION_KEY=
# PHOTO_ENCRYPTION_KEY_ID=local-1
# To rotate: set a new key + id, and list the old one here so old files stay readable
# PHOTO_ENCRYPTION_OLD_KEYS=local-1:<old base64 key>
